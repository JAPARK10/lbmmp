                "angry": 1.4627221024199613,
                "calm": 0.7870694349965788,
                "disgust": 0.8474238413370331,
                "fearful": 1.1372790944943933,
                "happy": 1.2420689462565506,
                "neutral": 1.0610346526654286,
                "sad": 0.7673108725705132,
                "surprised": 1.2775265365886743
            },
            "text_emotion": {
                "angry": 0,
                "calm": 7,
                "disgust": 0,
                "fearful": 0,
                "happy": 6,
                "neutral": 9,
                "sad": 0,
                "surprised": 0
            },
            "fused_emotion": {
