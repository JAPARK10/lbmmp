                "angry": 1.3555104939466056,
                "calm": 0.8695652607577665,
                "disgust": 0.9039311654554558,
                "fearful": 1.1639772666066879,
                "happy": 1.0915809044283837,
                "neutral": 1.0782552579450178,
                "sad": 0.7266651572246748,
                "surprised": 1.3929479801072835
            },
            "text_emotion": {
                "angry": 0,
                "calm": 7,
                "disgust": 0,
                "fearful": 0,
                "happy": 0,
                "neutral": 9,
