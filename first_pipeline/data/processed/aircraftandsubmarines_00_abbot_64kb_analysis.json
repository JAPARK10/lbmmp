        {
            "sentence_index": 9,
            "timestamp": {
                "start": 71.18,
                "end": 84.5
            },
            "transcript": "From the earliest days of history, men have grappled with a problem, yet it is only within two hundred years for aircraft and one hundred for submarines that any really intelligent start has been made upon its solution.",
            "acoustic_emotion": {
                "angry": 1.4112099008755428,
                "calm": 0.9932563850393685,
                "disgust": 0.8819403577577006,
                "fearful": 1.084680693173,
