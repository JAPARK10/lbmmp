                "disgust": 0.10281695139990489,
                "fearful": 0.10636200365329695,
                "happy": 0.16160393006103524,
                "neutral": 0.15391761216336622,
                "sad": 0.09774192603862762,
                "surprised": 0.1120072513370863
            }
        },
        {
            "sentence_index": 11,
            "timestamp": {
                "start": 103.28,
                "end": 110.58
            },
            "transcript": "In this book, the author has sketched swiftly the slow stages by which in each of these fields of activity success has been attained.",
