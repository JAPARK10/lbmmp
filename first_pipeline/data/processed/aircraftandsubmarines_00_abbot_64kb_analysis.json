                "neutral": 1.1702670515411269,
                "sad": 0.5622215927339319,
                "surprised": 1.4001673685239453
            },
            "text_emotion": {
                "angry": 0,
                "calm": 9,
                "disgust": 0,
                "fearful": 0,
                "happy": 0,
                "neutral": 7,
                "sad": 0,
